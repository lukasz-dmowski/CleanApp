<UserControl x:Class="CleanApp.Views.ViewOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CleanApp"
             xmlns:enum="clr-namespace:CleanApp.Enums"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:help="clr-namespace:CleanApp.Helpers"
             xmlns:models="clr-namespace:CleanApp.Models"
             xmlns:resources="clr-namespace:CleanApp.Resources"   
             mc:Ignorable="d"
             d:DesignHeight="560" 
             d:DesignWidth="1130"
             d:Background="{StaticResource brush_background_dark}"
             >
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="710"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource border_style_dashboard_tile_light}"
                    >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>
                    
                    <Button Grid.Column="3"
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            Style="{StaticResource button_style_iconOnlySmall}"
                            Command="{Binding ResetFilterCommand}"
                            help:ButtonIconHelper.IconKind="Reload"
                            />
                    <TextBox Grid.Column="1" 
                             Grid.Row="1"
                             Height="30"
                             Style="{StaticResource textBox_style_default}"
                             Text="{Binding SearchPhrase, 
                                            Mode=TwoWay, 
                                            UpdateSourceTrigger=Explicit}"
                             x:Name="SearchTextBox"
                             KeyDown="SearchTextBox_KeyDown"
                             Padding="5 0 0 0"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Universal_TextBox_SearchPhrase_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                    <StackPanel Grid.Column="2"
                                Grid.Row="1"
                                Orientation="Horizontal"                        
                                HorizontalAlignment="Right"
                                >
                        <Button Command="{Binding FirstPageCommand}"
                                Style="{StaticResource button_style_iconOnlyBig}"
                                help:ButtonIconHelper.IconKind="ChevronDoubleLeft"
                                />
                        <Button Command="{Binding PreviousPageCommand}"
                                Style="{StaticResource button_style_iconOnlyBig}"
                                help:ButtonIconHelper.IconKind="ChevronLeft"
                                />
                        <TextBlock Text="{Binding CurrentPage, StringFormat={}{0:D3}}"
                                   d:Text="000"
                                   VerticalAlignment="Center"
                                   Margin="20 0 0 0"
                                   Style="{StaticResource textBlock_style_default}"
                                   />
                        <TextBlock Text="  /  " 
                                   VerticalAlignment="Center"
                                   Style="{StaticResource textBlock_style_default}"
                                   />
                        <TextBlock Text="{Binding TotalPages, StringFormat={}{0:D3}}"
                                   d:Text="000"
                                   VerticalAlignment="Center"
                                   Margin="0 0 20 0"
                                   Style="{StaticResource textBlock_style_default}"
                                   />
                        <Button Command="{Binding NextPageCommand}"
                                Style="{StaticResource button_style_iconOnlyBig}"
                                help:ButtonIconHelper.IconKind="ChevronRight"
                                />
                        <Button Command="{Binding LastPageCommand}"
                                Style="{StaticResource button_style_iconOnlyBig}"
                                help:ButtonIconHelper.IconKind="ChevronDoubleRight"
                                />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="10"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>

                    <!-- READINESS -->
                    <StackPanel Grid.Column="1"
                                Grid.Row="1"
                                Orientation="Horizontal">

                        <!-- Pending -->
                        <CheckBox IsChecked="{Binding PendingFilter.IsChecked}"
                                  IsEnabled="{Binding PendingFilter.IsEnabled}"
                                  Style="{StaticResource checkBox_style_filter_a}"
                                  Width="120"
                                  >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CircleOutline"
                                                         VerticalAlignment="Center"
                                                         Foreground="Black"
                                                         Height="16"
                                                         Width="16"
                                                         Margin="0 0 4 0"
                                                         />
                                <TextBlock Text="{x:Static resources:Language.View_CheckBox_FilterPending}"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Partial -->
                        <CheckBox IsChecked="{Binding PartialFilter.IsChecked}"
                                  IsEnabled="{Binding PartialFilter.IsEnabled}"
                                  Style="{StaticResource checkBox_style_filter_a}"
                                  Width="120"
                                  >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CircleHalfFull"
                                                         VerticalAlignment="Center"
                                                         Foreground="Black"
                                                         Height="16"
                                                         Width="16"
                                                         Margin="0 0 4 0"
                                                         />
                                <TextBlock Text="{x:Static resources:Language.View_CheckBox_FilterPartially}"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Completed -->
                        <CheckBox IsChecked="{Binding CompletedFilter.IsChecked}"
                                  IsEnabled="{Binding CompletedFilter.IsEnabled}"
                                  Style="{StaticResource checkBox_style_filter_a}"
                                  Width="140"
                                  >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Circle"
                                                         VerticalAlignment="Center"
                                                         Foreground="Black"
                                                         Height="16"
                                                         Width="16"
                                                         Margin="0 0 4 0"
                                                         />
                                <TextBlock Text="{x:Static resources:Language.View_CheckBox_FilterCompleted}"/>
                            </StackPanel>
                        </CheckBox>

                    </StackPanel>

                    <!-- SCHEDULE -->
                    <StackPanel Grid.Column="1"
                                Grid.Row="2"
                                Orientation="Horizontal">

                        <!-- Overdue -->
                        <CheckBox IsChecked="{Binding OverdueFilter.IsChecked}"
                                  IsEnabled="{Binding OverdueFilter.IsEnabled}"
                                  Style="{StaticResource checkBox_style_filter_c}"
                                  Width="120"
                                  >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronLeftCircleOutline"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource brush_accent_a}"
                                                         Height="16"
                                                         Width="16"
                                                         Margin="0 0 4 0"
                                                         />
                                <TextBlock Text="{x:Static resources:Language.View_CheckBox_FilterOverdue}"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Today -->
                        <CheckBox IsChecked="{Binding TodayFilter.IsChecked}"
                                  IsEnabled="{Binding TodayFilter.IsEnabled}"
                                  Style="{StaticResource checkBox_style_filter_c}"
                                  Width="120"
                                  >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronDownCircleOutline"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource brush_accent_b}"
                                                         Height="16"
                                                         Width="16"
                                                         Margin="0 0 4 0"
                                                         />
                                <TextBlock Text="{x:Static resources:Language.View_CheckBox_FilterToday}"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Upcoming -->
                        <CheckBox IsChecked="{Binding UpcomingFilter.IsChecked}"
                                  IsEnabled="{Binding UpcomingFilter.IsEnabled}"
                                  Style="{StaticResource checkBox_style_filter_c}"
                                  Width="140"
                                  >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronRightCircleOutline"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource brush_accent_c}"
                                                         Height="16"
                                                         Width="16"
                                                         Margin="0 0 4 0"
                                                         />
                                <TextBlock Text="{x:Static resources:Language.View_CheckBox_FilterUpcoming}"/>
                            </StackPanel>
                        </CheckBox>

                    </StackPanel>

                    <!-- NOTIFICATION -->
                    <StackPanel Grid.Column="2"
                                Grid.Row="1"
                                Orientation="Horizontal"
                                >

                        <!-- Notified -->
                        <CheckBox IsChecked="{Binding NotifiedFilter.IsChecked}"
                                  IsEnabled="{Binding NotifiedFilter.IsEnabled}"
                                  Style="{StaticResource checkBox_style_filter_b}"
                                  Width="120"
                                  >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Alarm"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource brush_accent_c}"
                                                         Height="16"
                                                         Width="16"
                                                         Margin="0 0 4 0"
                                                         />
                                <TextBlock Text="{x:Static resources:Language.View_CheckBox_FilterNotified}"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Not Notified -->
                        <CheckBox IsChecked="{Binding NotNotifiedFilter.IsChecked}"
                                  IsEnabled="{Binding NotNotifiedFilter.IsEnabled}"
                                  Style="{StaticResource checkBox_style_filter_b}"
                                  Width="140"
                                  >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Alarm"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource brush_accent_a}"
                                                         Height="16"
                                                         Width="16"
                                                         Margin="0 0 4 0"
                                                         />
                                <TextBlock Text="{x:Static resources:Language.View_CheckBox_FilterNotNotified}"/>
                            </StackPanel>
                        </CheckBox>

                    </StackPanel>

                    <!-- COLLECTION -->
                    <StackPanel Grid.Column="2"
                                Grid.Row="2"
                                Orientation="Horizontal"
                                >

                        <!-- Collected -->
                        <CheckBox IsChecked="{Binding CollectedFilter.IsChecked}"
                                  IsEnabled="{Binding CollectedFilter.IsEnabled}"
                                  Style="{StaticResource checkBox_style_filter_b}"
                                  Width="120"
                                  >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource brush_accent_c}"
                                                         Height="16"
                                                         Width="16"
                                                         Margin="0 0 4 0"
                                                         />
                                <TextBlock Text="{x:Static resources:Language.View_CheckBox_FilterCollected}"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Not Collected -->
                        <CheckBox IsChecked="{Binding NotCollectedFilter.IsChecked}"
                                  IsEnabled="{Binding NotCollectedFilter.IsEnabled}"
                                  Style="{StaticResource checkBox_style_filter_b}"
                                  Width="140"
                                  >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource brush_accent_a}"
                                                         Height="16"
                                                         Width="16"
                                                         Margin="0 0 4 0"
                                                         />
                                <TextBlock Text="{x:Static resources:Language.View_CheckBox_FilterNotCollected}"/>
                            </StackPanel>
                        </CheckBox>

                    </StackPanel>

                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Style="{StaticResource border_style_dashboard_tile_dark}"
                    >
                <ListView ItemsSource="{Binding FilteredOrders}"
                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                          Style="{StaticResource listView_style_default}"                      
                          materialDesign:ListViewAssist.ListViewItemPadding="7"
                          >
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader"
                               BasedOn="{StaticResource listViewHearder_style_default}"/>
                    </ListView.Resources>

                    <d:ListView.Items>
                        <models:Order OrderNumber="8888" ClientName="name surname"/>
                        <models:Order OrderNumber="8889" ClientName="name surname"/>
                    </d:ListView.Items>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="45"
                                            DisplayMemberBinding="{Binding OrderNumber}"
                                            >
                                <GridViewColumn.Header>
                                    <materialDesign:PackIcon Kind="FormatListBulleted"
                                                             Width="15"
                                                             Height="15"
                                                             Foreground="{StaticResource brush_icon}"
                                                             />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static resources:Language.View_ListView_ColumnName}"
                                            Width="155"
                                            DisplayMemberBinding="{Binding ClientName}"
                                            />
                            <GridViewColumn Header="{x:Static resources:Language.View_ListView_ColumnTelephone}"
                                            Width="90"
                                            DisplayMemberBinding="{Binding TelephoneNumber}"
                                            />
                            <GridViewColumn Header="{x:Static resources:Language.View_ListView_ColumnStartDate}"
                                            Width="90"
                                            DisplayMemberBinding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}"
                                            />
                            <GridViewColumn Header="{x:Static resources:Language.View_ListView_ColumnDueDate}"
                                            Width="90"
                                            DisplayMemberBinding="{Binding DueDate, StringFormat={}{0:dd.MM.yyyy}}"
                                            />
                            <GridViewColumn Width="30"
                                            DisplayMemberBinding="{Binding ItemsCount}"
                                            >
                                <GridViewColumn.Header>
                                    <materialDesign:PackIcon Kind="TshirtCrewOutline"
                                                             Width="15"
                                                             Height="15"
                                                             Foreground="{StaticResource brush_icon}"
                                                             />
                                </GridViewColumn.Header>
                            </GridViewColumn>
                            <GridViewColumn Width="25">
                                <GridViewColumn.Header>
                                    <materialDesign:PackIcon Kind="ChevronDownCircleOutline"
                                                             Width="15"
                                                             Height="15"
                                                             Foreground="{StaticResource brush_icon}"
                                                             />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Height="15" 
                                                                 Width="15"
                                                                 HorizontalAlignment="Center"
                                                                 >
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="None"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ScheduleStatus}" 
                                                                     Value="{x:Static enum:OrderScheduleStatus.Overdue}">
                                                            <Setter Property="Kind" Value="ChevronLeftCircleOutline"/>
                                                            <Setter Property="Foreground" Value="{StaticResource brush_accent_a}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ScheduleStatus}" 
                                                                     Value="{x:Static enum:OrderScheduleStatus.Today}">
                                                            <Setter Property="Kind" Value="ChevronDownCircleOutline"/>
                                                            <Setter Property="Foreground" Value="{StaticResource brush_accent_b}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ScheduleStatus}" 
                                                                     Value="{x:Static enum:OrderScheduleStatus.Upcoming}">
                                                            <Setter Property="Kind" Value="ChevronRightCircleOutline"/>
                                                            <Setter Property="Foreground" Value="{StaticResource brush_accent_c}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ScheduleStatus}" 
                                                                     Value="{x:Static enum:OrderScheduleStatus.None}">
                                                            <Setter Property="Kind" Value="None"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="25">
                                <GridViewColumn.Header>
                                    <materialDesign:PackIcon Kind="CircleHalfFull"
                                                             Width="15"
                                                             Height="15"
                                                             Foreground="{StaticResource brush_icon}"
                                                             />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Height="15" 
                                                                 Width="15"
                                                                 HorizontalAlignment="Center"
                                                                 >
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="None"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ReadinessStatus}" 
                                                                     Value="{x:Static enum:OrderReadinessStatus.Completed}">
                                                            <Setter Property="Kind" Value="Circle"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ReadinessStatus}" 
                                                                     Value="{x:Static enum:OrderReadinessStatus.Partial}">
                                                            <Setter Property="Kind" Value="CircleHalfFull"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ReadinessStatus}" 
                                                                     Value="{x:Static enum:OrderReadinessStatus.Pending}">
                                                            <Setter Property="Kind" Value="CircleOutline"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="25">
                                <GridViewColumn.Header>
                                    <materialDesign:PackIcon Kind="Alarm"
                                                             Width="15"
                                                             Height="15"
                                                             Foreground="{StaticResource brush_icon}"
                                                             />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Height="15" 
                                                                 Width="15"
                                                                 HorizontalAlignment="Center"
                                                                 >
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="None"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NotificationStatus}" 
                                                                     Value="{x:Static enum:OrderNotificationStatus.Notified}">
                                                            <Setter Property="Kind" Value="Alarm"/>
                                                            <Setter Property="Foreground" Value="{StaticResource brush_accent_c}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NotificationStatus}"
                                                                     Value="{x:Static enum:OrderNotificationStatus.NotNotified}">
                                                            <Setter Property="Kind" Value="Alarm"/>
                                                            <Setter Property="Foreground" Value="{StaticResource brush_accent_a}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NotificationStatus}"
                                                                     Value="{x:Static enum:OrderNotificationStatus.None}">
                                                            <Setter Property="Kind" Value="None"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="25">
                                <GridViewColumn.Header>
                                    <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                             Width="15"
                                                             Height="15"
                                                             Foreground="{StaticResource brush_icon}"
                                                             />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Height="15" 
                                                                 Width="15"
                                                                 HorizontalAlignment="Center"
                                                                 >
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="None"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CollectionStatus}" 
                                                                     Value="{x:Static enum:OrderCollectionStatus.Collected}">
                                                            <Setter Property="Kind" Value="CheckCircleOutline"/>
                                                            <Setter Property="Foreground" Value="{StaticResource brush_accent_c}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CollectionStatus}"
                                                                     Value="{x:Static enum:OrderCollectionStatus.NotCollected}">
                                                            <Setter Property="Kind" Value="CheckCircleOutline"/>
                                                            <Setter Property="Foreground" Value="{StaticResource brush_accent_a}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CollectionStatus}"
                                                                     Value="{x:Static enum:OrderCollectionStatus.None}">
                                                            <Setter Property="Kind" Value="None"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{x:Static resources:Language.View_ListView_ColumnEndDate}"
                                            Width="90"
                                            DisplayMemberBinding="{Binding EndDate, StringFormat={}{0:dd MM yyyy}}"
                                            />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <Grid Grid.Column="3"
              Grid.Row="1"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Column="1" Grid.ColumnSpan="3"
                             Grid.Row="1"
                             MaxLength="20"
                             Text="{Binding EditedOrder.ClientName, 
                                            Mode=TwoWay, 
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"            
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Universal_TextBox_Name_Hint}"                      
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Account"                         
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                    <TextBox Grid.Column="5"
                             Grid.Row="1"
                             MaxLength="9"
                             Text="{Binding EditedOrder.TelephoneNumber, 
                                            Mode=TwoWay, 
                                            UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             PreviewTextInput="TelephoneNumber_PreviewTextInput"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Universal_TextBox_Telephone_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Phone"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                    <StackPanel Grid.Column="1"
                                Grid.Row="3"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" 
                                                 Kind="FormatListBulleted" 
                                                 Foreground="{StaticResource brush_icon}"
                                                 Height="18"
                                                 Width="18"
                                                 />
                        <TextBlock Text="{Binding EditedOrder.OrderNumber}"
                                   d:Text="000"
                                   Style="{StaticResource textBlock_style_default}"
                                   Margin="5 0 0 0"
                                   />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Grid.Row="3"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" 
                                                 Kind="TshirtCrewOutline" 
                                                 Foreground="{StaticResource brush_icon}"
                                                 Height="18"
                                                 Width="18"/>
                        <TextBlock Text="{Binding EditedOrder.ItemsCount}"
                                   d:Text="000"
                                   Style="{StaticResource textBlock_style_default}"
                                   Margin="5 0 0 0"
                                   />
                    </StackPanel>
                    <StackPanel Grid.Column="3"
                                Grid.Row="3"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" 
                                                 Kind="CurrencyUsd" 
                                                 Foreground="{StaticResource brush_icon}"
                                                 Height="18"
                                                 Width="18"/>
                        <TextBlock Text="{Binding EditedOrder.Price}"
                                   d:Text="000"
                                   Style="{StaticResource textBlock_style_default}"
                                   Margin="5 0 0 0"
                                   />
                    </StackPanel>
                    <DatePicker Grid.Column="5"
                                Grid.Row="3"
                                SelectedDate="{Binding EditedOrder.StartDate, 
                                                       Mode=TwoWay, 
                                                       UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource datePicker_style_default}"
                                materialDesign:HintAssist.Hint="{x:Static resources:Language.Universal_DatePicker_StartDate_Hint}"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="RayStart"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                />
                    <DatePicker Grid.Column="5"
                                Grid.Row="5"
                                SelectedDate="{Binding EditedOrder.DueDate, 
                                                       Mode=TwoWay, 
                                                       UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource datePicker_style_default}"
                                materialDesign:HintAssist.Hint="{x:Static resources:Language.Universal_DatePicker_DueDate_Hint}"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="RayVertex"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                />
                    <DatePicker Grid.Column="5"
                                Grid.Row="7"
                                SelectedDate="{Binding EditedOrder.EndDate, 
                                                       Mode=TwoWay, 
                                                       UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding EditedOrder.CollectionStatus, 
                                                    Converter={StaticResource OrderCollectionToEnabledConverter}}"
                                Style="{StaticResource datePicker_style_default}"
                                materialDesign:HintAssist.Hint="{x:Static resources:Language.Universal_DatePicker_EndDate_Hint}"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="RayEnd"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                />

                    <StackPanel Grid.Column="1" Grid.ColumnSpan="3"
                                Grid.Row="5"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" 
                                                 Kind="Alarm" 
                                                 Foreground="{StaticResource brush_icon}"
                                                 Height="18"
                                                 Width="18"/>
                        <CheckBox Content="{x:Static resources:Language.View_CheckBox_WasClientNotofied}"
                                  IsChecked="{Binding EditedOrder.NotificationStatus, 
                                                      Mode=TwoWay, 
                                                      Converter={StaticResource OrderNotificationToBoolConverter}}"
                                  IsEnabled="{Binding EditedOrder.ReadinessStatus, 
                                                      Converter={StaticResource OrderReadinessToEnabledConverter}}"
                                  IsThreeState="False"
                                  Style="{StaticResource checkBox_style_default}"                          
                                  />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.ColumnSpan="3"
                                Grid.Row="7"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" 
                                                 Kind="CheckCircleOutline" 
                                                 Foreground="{StaticResource brush_icon}"
                                                 Height="18"
                                                 Width="18"/>
                        <CheckBox Content="{x:Static resources:Language.View_CheckBox_WasOrderCollected}"
                                  IsChecked="{Binding EditedOrder.CollectionStatus, 
                                                      Mode=TwoWay, 
                                                      Converter={StaticResource OrderCollectionToBoolConverter}}"
                                  IsEnabled="{Binding EditedOrder.NotificationStatus, 
                                                      Converter={StaticResource OrderNotificationToEnabledConverter}}"
                                  IsThreeState="False"
                                  Style="{StaticResource checkBox_style_default}"                          
                                  />
                    </StackPanel>




                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource border_style_dashboard_tile_dark}">
                    
                <ListView Grid.Column="1"
                          Grid.Row="1"
                          ItemsSource="{Binding EditedOrder.Items, 
                                                Mode=TwoWay}"
                          Style="{StaticResource listView_style_default}"
                          materialDesign:ListViewAssist.ListViewItemPadding="3"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          >
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader"
                               BasedOn="{StaticResource listViewHearder_style_default}"/>
                    </ListView.Resources>

                    <d:ListView.Items>
                        <models:Item ItemNumber="1" Price="8888" Type="Other" ReadinessStatus="Completed"/>
                        <models:Item ItemNumber="2" Price="888" Type="Other" ReadinessStatus="Completed"/>
                        <models:Item ItemNumber="3" Price="88" Type="Other" ReadinessStatus="Completed"/>
                        <models:Item ItemNumber="4" Price="8" Type="Other" ReadinessStatus="Completed"/>
                    </d:ListView.Items>

                    <ListView.View>
                        <GridView>

                            <GridViewColumn Width="45">
                                <GridViewColumn.Header>
                                    <materialDesign:PackIcon Kind="FormatListBulleted"
                                                             Width="15"
                                                             Height="15"
                                                             Foreground="{StaticResource brush_icon}"
                                                             />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ItemNumber}"
                                                   Margin="5 0 0 0"
                                                   Style="{StaticResource textBlock_style_default}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="120"
                                            Header="{x:Static resources:Language.View_ListView_ColumnType}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource comboBox_style_default}"
                                                  ItemsSource="{Binding DataContext.ItemTypes,
                                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  SelectedItem="{Binding Type, 
                                                                         Mode=TwoWay, 
                                                                         UpdateSourceTrigger=PropertyChanged}"
                                                  Width="105"
                                                  >
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ItemTypeEnumToTextConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="120"
                                            Header="{x:Static resources:Language.View_ListView_ColumnStatus}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource comboBox_style_default}"
                                                  ItemsSource="{Binding DataContext.ItemReadinessStatuses,
                                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  SelectedItem="{Binding ReadinessStatus, 
                                                                         Mode=TwoWay, 
                                                                         UpdateSourceTrigger=PropertyChanged}"
                                                  Width="105"
                                                  >
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ItemStatusEnumToTextConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="45">
                                <GridViewColumn.Header>
                                    <materialDesign:PackIcon Kind="CurrencyUsd"
                                                             Width="15"
                                                             Height="15"
                                                             Foreground="{StaticResource brush_icon}"
                                                             />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Width="40"
                                                 MaxLength="3"
                                                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                 PreviewTextInput="ItemPrice_PreviewTextInput"
                                                 Text="{Binding Price,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged,
                                                                TargetNullValue=''}"
                                                 Style="{StaticResource textBox_style_default}"
                                                 />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="45">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveItemCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource button_style_iconOnlySmall}"
                                                help:ButtonIconHelper.IconKind="Close"
                                                />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border Grid.Row="4"
                    Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>

                    <ComboBox Grid.Column="1"
                              Grid.Row="1"
                              Height="30"
                              Width="105"
                              Style="{StaticResource comboBox_style_default}"
                              ItemsSource="{Binding ItemTypes}"
                              SelectedItem="{Binding NewItem.Type, 
                                                     Mode=TwoWay}"
                              VerticalContentAlignment="Center"
                              >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ItemTypeEnumToTextConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Grid.Column="2"
                              Grid.Row="1"
                              Height="30"
                              Width="105"
                              Style="{StaticResource comboBox_style_default}"
                              ItemsSource="{Binding ItemReadinessStatuses}"
                              SelectedItem="{Binding NewItem.ReadinessStatus, 
                                                     Mode=TwoWay}"
                              VerticalContentAlignment="Center"
                              >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ItemStatusEnumToTextConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox Grid.Column="3"
                             Grid.Row="1"
                             Width="30"
                             MaxLength="3"
                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                             Text="{Binding NewItemPrice,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             d:Text="000"
                             Style="{StaticResource textBox_style_default}"
                             PreviewTextInput="ItemPrice_PreviewTextInput"
                             />
                    <Button Grid.Column="5"
                            Grid.Row="1"
                            Command="{Binding AddItemCommand}"
                            Style="{StaticResource button_style_iconOnlySmall}"
                            help:ButtonIconHelper.IconKind="Plus"
                            />

                </Grid>
            </Border>

            <Border Grid.Row="6"
                    Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Column="1"
                            Grid.Row="1"
                            Content="{x:Static resources:Language.View_Button_Undo}"
                            Command="{Binding UndoChangesCommand}"
                            Style="{StaticResource button_style_minor}"
                            help:ButtonIconHelper.IconKind="Reload"
                            />
                    <Button Grid.Column="3"
                            Grid.Row="1" 
                            Content="{x:Static resources:Language.View_Button_Delete}"
                            Command="{Binding DeleteOrderCommand}"
                            Style="{StaticResource button_style_minor}"
                            help:ButtonIconHelper.IconKind="delete"
                            />
                    <Button Grid.Column="5"
                            Grid.Row="1" 
                            Content="{x:Static resources:Language.View_Button_Print}"
                            Command="{Binding PrintOrderCommand}"
                            Style="{StaticResource button_style_minor}"
                            help:ButtonIconHelper.IconKind="Printer"
                            />
                    <Button Grid.Column="1" Grid.ColumnSpan="5"
                            Grid.Row="3" 
                            Content="{x:Static resources:Language.View_Button_Update}"
                            Command="{Binding UpdateOrderCommand}"
                            Style="{StaticResource button_style_majorSolid}"
                            help:ButtonIconHelper.IconKind="ContentSave"
                            />
                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>
