<UserControl x:Class="CleanApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CleanApp"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:h="clr-namespace:CleanApp.Helpers"
             xmlns:resources="clr-namespace:CleanApp.Resources"
             mc:Ignorable="d" 
             d:DesignHeight="680" 
             d:DesignWidth="1200"
             Background="{StaticResource brush_background_dark}"
             >
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="2"
                Grid.Column="0"
                Background="{StaticResource brush_background_dark}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="1"
                           Grid.Row="1"
                           Text="{x:Static resources:Language.Login_TextBlock_Welcome}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="20"
                           Style="{StaticResource textBlock_style_dashboardTitle}"
                           />
                <TextBox Grid.Column="1"
                         Grid.Row="3"
                         MaxLength="30"
                         Text="{Binding Username, 
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource textBox_style_default}"                             
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Account"
                         materialDesign:TextFieldAssist.HasClearButton ="True"
                         />
                <PasswordBox Grid.Column="1"
                             Grid.Row="5"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Style="{StaticResource passwordBox_style_login}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Lock"
                             materialDesign:TextFieldAssist.LeadingIconSize="16"
                             materialDesign:TextFieldAssist.HasClearButton ="True"
                             materialDesign:HintAssist.HelperText="{x:Static resources:Language.Universal_TextBlock_Lenght_HelperText}"
                             />
                <StackPanel Grid.Column="1"
                            Grid.Row="7"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="{x:Static resources:Language.Login_Button_Exit}"
                            Width="145"
                            Command="{Binding ExitCommand}"
                            Style="{StaticResource button_style_majorOutline}"
                            h:ButtonIconHelper.IconKind="LocationExit"
                            />
                    <Button Content="{x:Static resources:Language.Login_Button_Login}"
                            Width="145"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource button_style_majorSolid}"
                            h:ButtonIconHelper.IconKind="LocationEnter"
                            Margin="10 0 0 0"/>
                </StackPanel>
            </Grid>            
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="2"
                Grid.Column="1"
                Background="{StaticResource brush_ribbon_dark}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="290"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="1"
                           Grid.Row="1"
                           Text="{x:Static resources:Language.Universal_TextBlock_AppName}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="20"
                           Style="{StaticResource textBlock_style_dashboardTitle}"
                           Foreground="White"
                           />
                <TextBlock Grid.Column="1"
                           Grid.Row="2"
                           Text="{x:Static resources:Language.Universal_TextBlock_AppDescription}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="20"
                           Style="{StaticResource textBlock_style_dashboardHeader}"
                           Foreground="White"
                           />
            </Grid>
        </Border>

        <Button Grid.Column="0" Grid.ColumnSpan="2"
                Grid.Row="0"
                Command="{Binding DragWindowCommand}"
                Style="{StaticResource button_style_drag}"
                PreviewMouseLeftButtonDown="DragButton_PreviewMouseLeftButtonDown"/>

        <StackPanel Grid.Column="0" Grid.ColumnSpan="3"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Command="{Binding MinimizeWindowCommand}"
                    Height="50"
                    Width="50"
                    Style="{StaticResource button_style_iconShell}"
                    h:ButtonIconHelper.IconKind="WindowMinimize"/>
            <Button Command="{Binding MaximizeWindowCommand}"
                    Height="50"
                    Width="50"
                    Style="{StaticResource button_style_iconShell}"
                    h:ButtonIconHelper.IconKind="WindowMaximize"/>
            <Button Command="{Binding ExitCommand}"
                    Height="50"
                    Width="50"
                    Style="{StaticResource button_style_iconShell}"
                    h:ButtonIconHelper.IconKind="WindowClose"/>
        </StackPanel>

    </Grid>
</UserControl>
