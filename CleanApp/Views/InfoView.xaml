<UserControl x:Class="CleanApp.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CleanApp.Views"
             xmlns:enum="clr-namespace:CleanApp.Enums"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:help="clr-namespace:CleanApp.Helpers"
             xmlns:models="clr-namespace:CleanApp.Models"
             xmlns:resources="clr-namespace:CleanApp.Resources"   
             mc:Ignorable="d" 
             d:DesignHeight="570" d:DesignWidth="1020"
             d:Background="{StaticResource brush_background_dark}"
             >
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="1"
              Grid.Row="0"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="1"
                               Grid.Row="1"
                               Text="{Binding Version}"
                               Style="{StaticResource textBlock_style_default}"
                               />
                </Grid>
            </Border>
            
            <Border Grid.Row="2"
                    Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Column="1" Grid.ColumnSpan="3"
                             Grid.Row="1"
                             MaxLength="30"
                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Info_TextBox_EnterpriseName_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Tag"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                    <TextBox Grid.Column="1" Grid.ColumnSpan="3"
                             Grid.Row="3"
                             MaxLength="30"
                             Text="{Binding Owner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Info_TextBox_OwnerName_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Account"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                    <TextBox Grid.Column="1"
                             Grid.Row="5"
                             MaxLength="20"
                             Text="{Binding Street, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Info_TextBox_StreetName_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="MapMarker"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                    <TextBox Grid.Column="3"
                             Grid.Row="5"
                             MaxLength="10"
                             Text="{Binding BuildingNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Info_TextBox_StreetNumber_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Counter"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                    <TextBox Grid.Column="1"
                             Grid.Row="7"
                             MaxLength="20"
                             Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Info_TextBox_CityName_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="City"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                    <TextBox Grid.Column="3"
                             Grid.Row="7"
                             MaxLength="10"
                             Text="{Binding PostalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Info_TextBox_CityCode_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="counter"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                    <TextBox Grid.Column="1" Grid.ColumnSpan="3"
                             Grid.Row="9"
                             MaxLength="30"
                             Text="{Binding TelephoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Info_TextBox_Telephone_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Phone"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                    <TextBox Grid.Column="1" Grid.ColumnSpan="3"
                             Grid.Row="11"
                             MaxLength="30"
                             Text="{Binding ExtraInfo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Info_TextBox_ExtraInfo}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Web"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                </Grid>
            </Border>
            
            <Border Grid.Row="4"
                    Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Column="1"
                            Grid.Row="1"
                            Content="{x:Static resources:Language.Info_Button_Undo}"
                            Command="{Binding UndoChangesCommand}"
                            Style="{StaticResource button_style_minor}"
                            help:ButtonIconHelper.IconKind="Reload"
                            />
                    <Button Grid.Column="3"
                            Grid.Row="1"
                            Content="{x:Static resources:Language.Info_Button_Clear}"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource button_style_minor}"
                            help:ButtonIconHelper.IconKind="Eraser"
                            />
                    <Button Grid.Column="1" Grid.ColumnSpan="3"
                            Grid.Row="3" 
                            Content="{x:Static resources:Language.Info_Button_Save}"
                            Command="{Binding SaveChangesCommand}"
                            Style="{StaticResource button_style_majorSolid}"
                            help:ButtonIconHelper.IconKind="ContentSave"
                            />
                </Grid>
            </Border>

        </Grid>

    </Grid>

</UserControl>
