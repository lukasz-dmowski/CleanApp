<UserControl x:Class="CleanApp.Views.AddOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CleanApp.Views"
             xmlns:enum="clr-namespace:CleanApp.Enums"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:help="clr-namespace:CleanApp.Helpers"
             xmlns:models="clr-namespace:CleanApp.Models"
             xmlns:resources="clr-namespace:CleanApp.Resources"             
             mc:Ignorable="d" 
             d:DesignHeight="570" d:DesignWidth="1020"
             d:Background="{StaticResource brush_background_dark}"
             >
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="1"
              Grid.Row="1"
              >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Column="1" Grid.ColumnSpan="3"
                             Grid.Row="1"
                             MaxLength="20"
                             Text="{Binding NewOrder.ClientName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Universal_TextBox_Name_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Account"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                    <DatePicker Grid.Column="5"
                                Grid.Row="1"
                                SelectedDate="{Binding NewOrder.StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource datePicker_style_default}"
                                materialDesign:HintAssist.Hint="{x:Static resources:Language.Universal_DatePicker_StartDate_Hint}"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="RayStart"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                />
                    <TextBox Grid.Column="1" Grid.ColumnSpan="3"
                             Grid.Row="3"
                             MaxLength="9"
                             Text="{Binding NewOrder.TelephoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             PreviewTextInput="TelephoneNumber_PreviewTextInput"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Universal_TextBox_Telephone_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Phone"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             />
                    <DatePicker Grid.Column="5"
                                Grid.Row="3"
                                SelectedDate="{Binding NewOrder.DueDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource datePicker_style_default}"
                                materialDesign:HintAssist.Hint="{x:Static resources:Language.Universal_DatePicker_DueDate_Hint}"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="RayVertex"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                />
                    <StackPanel Grid.Column="1"
                                Grid.Row="5"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" 
                                                 Kind="FormatListBulleted" 
                                                 Foreground="{StaticResource brush_icon}"
                                                 Height="18"
                                                 Width="18"/>
                        <TextBlock Text="{Binding NewOrder.OrderNumber}"
                                   d:Text="0000"
                                   Style="{StaticResource textBlock_style_default}"
                                   Margin="5 0 0 0"
                                   />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Grid.Row="5"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" 
                                                 Kind="TshirtCrewOutline" 
                                                 Foreground="{StaticResource brush_icon}"
                                                 Height="18"
                                                 Width="18"/>
                        <TextBlock Text="{Binding NewOrder.ItemsCount}"
                                   d:Text="0000"
                                   Style="{StaticResource textBlock_style_default}"
                                   Margin="5 0 0 0"
                                   />
                    </StackPanel>
                    <StackPanel Grid.Column="3"
                                Grid.Row="5"
                                Orientation="Horizontal">
                        <materialDesign:PackIcon HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" 
                                                 Kind="CurrencyUsd" 
                                                 Foreground="{StaticResource brush_icon}"
                                                 Height="18"
                                                 Width="18"/>
                        <TextBlock Text="{Binding NewOrder.Price}"
                                   d:Text="0000"
                                   Style="{StaticResource textBlock_style_default}"
                                   Margin="5 0 0 0"
                                   />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="10"/>
                    </Grid.RowDefinitions>

                    <ComboBox Grid.Column="1"
                              Grid.Row="1"
                              Height="30"
                              Width="225"
                              ItemsSource="{Binding ItemTypes}"
                              SelectedItem="{Binding NewItem.Type, 
                                                     Mode=TwoWay}"
                              VerticalContentAlignment="Center"
                              Style="{StaticResource comboBox_style_default}"
                              >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ItemTypeEnumToTextConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox Grid.Column="2"
                             Grid.Row="1"
                             Width="30"
                             MaxLength="3"
                             d:Text="000"
                             Text="{Binding NewItem.Price,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged,
                                            TargetNullValue=''}"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                             PreviewTextInput="ItemPrice_PreviewTextInput"
                             />
                    <Button Grid.Column="4"                            
                            Grid.Row="1"
                            Command="{Binding AddItemCommand}"
                            Style="{StaticResource button_style_iconOnlySmall}"
                            help:ButtonIconHelper.IconKind="Plus"
                            />
                </Grid>
            </Border>
            
            <Border Grid.Row="4"
                    Style="{StaticResource border_style_dashboard_tile_dark}">

                <ListView ItemsSource="{Binding NewOrder.Items, 
                                                Mode=TwoWay}"
                          Style="{StaticResource MaterialDesignListView}"
                          materialDesign:ListViewAssist.ListViewItemPadding="3"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          >
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader"
                               BasedOn="{StaticResource listViewHearder_style_default}"/>
                    </ListView.Resources>

                    <d:ListView.Items>
                        <models:Item ItemNumber="1" Price="8888" Type="Other"/>
                        <models:Item ItemNumber="2" Price="888" Type="Other"/>
                        <models:Item ItemNumber="3" Price="88" Type="Other"/>
                        <models:Item ItemNumber="4" Price="8" Type="Other"/>
                    </d:ListView.Items>

                    <ListView.View>
                        <GridView>

                            <GridViewColumn Width="45">
                                <GridViewColumn.Header>
                                    <materialDesign:PackIcon Kind="FormatListBulleted"
                                                             Width="15"
                                                             Height="15"
                                                             Foreground="{StaticResource brush_icon}"
                                                             />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ItemNumber}"
                                                   Margin="5 0 0 0"
                                                   Style="{StaticResource textBlock_style_default}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="240"
                                            Header="{x:Static resources:Language.Add_ListView_ColumnType}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.ItemTypes,
                                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  SelectedItem="{Binding Type, 
                                                                         Mode=TwoWay, 
                                                                         UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource comboBox_style_default}"
                                                  Width="225"
                                                  >
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ItemTypeEnumToTextConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="45">
                                <GridViewColumn.Header>
                                    <materialDesign:PackIcon Kind="CurrencyUsd"
                                                             Width="15"
                                                             Height="15"
                                                             Foreground="{StaticResource brush_icon}"
                                                             />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Width="45"
                                                 MaxLength="3"
                                                 materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                                 PreviewTextInput="ItemPrice_PreviewTextInput"
                                                 Text="{Binding Price,
                                                                Mode=TwoWay,
                                                                UpdateSourceTrigger=PropertyChanged,
                                                                TargetNullValue=''}"
                                                 Style="{StaticResource textBox_style_default}"
                                                 />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="45">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveItemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource button_style_iconOnlySmall}"
                                                help:ButtonIconHelper.IconKind="Close"
                                                />

                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border Grid.Row="6"
                    Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Column="1"
                            Grid.Row="1"
                            Content="{x:Static resources:Language.Add_Button_Clear}"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource button_style_minor}"
                            help:ButtonIconHelper.IconKind="Eraser"
                            />
                    <Button Grid.Column="1"
                            Grid.Row="3" 
                            Content="{x:Static resources:Language.Add_Button_Add}"
                            Command="{Binding AddOrderCommand}"
                            Style="{StaticResource button_style_majorSolid}"
                            help:ButtonIconHelper.IconKind="ContentSave"
                            />
                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>
