<UserControl x:Class="CleanApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CleanApp.Views"
             xmlns:enum="clr-namespace:CleanApp.Enums"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:help="clr-namespace:CleanApp.Helpers"
             xmlns:models="clr-namespace:CleanApp.Models"
             xmlns:resources="clr-namespace:CleanApp.Resources"
             mc:Ignorable="d" 
             d:DesignHeight="570" d:DesignWidth="1020"
             d:Background="{StaticResource brush_background_dark}">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="1"
                Grid.Row="0"
          >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="1" Grid.ColumnSpan="3"
                               Grid.Row="1"
                               Text="{x:Static resources:Language.Settings_TextBox_HeaderBackup}"
                               Style="{StaticResource textBlock_style_dashboardTitle}"
                               />
                    <TextBlock Grid.Column="1" Grid.ColumnSpan="3"
                               Grid.Row="2"
                               Text="{x:Static resources:Language.Settings_TextBox_DescriptionBackup}"
                               Style="{StaticResource textBlock_style_default}"
                               />
                    <TextBlock Grid.Column="1" Grid.ColumnSpan="3"
                               Grid.Row="4"
                               Text="{Binding BackupDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               
                               Style="{StaticResource textBlock_style_path}"
                               />
                    <Button Grid.Column="1"
                            Grid.Row="6"
                            Content="{x:Static resources:Language.Settings_Button_CopyPath}"
                            Command="{Binding CopyDirectoryCommand}"
                            Style="{StaticResource button_style_minor}"
                            help:ButtonIconHelper.IconKind="ContentCopy"
                            />
                    <Button Grid.Column="3"
                            Grid.Row="6"
                            Content="{x:Static resources:Language.Settings_Button_Browse}"
                            Command="{Binding BrowseBackupDirectoryCommand}"
                            Style="{StaticResource button_style_minor}"
                            help:ButtonIconHelper.IconKind="FolderOpenOutline"
                            />
                </Grid>
            </Border>
            
            <Border Grid.Row="2"
                Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>

                    </Grid.RowDefinitions>                 

                    <TextBlock Grid.Column="1" Grid.ColumnSpan="3"
                               Grid.Row="1"
                               Text="{x:Static resources:Language.Settings_TextBox_HeaderLogin}"
                               Style="{StaticResource textBlock_style_dashboardTitle}"
                               />
                    <TextBlock Grid.Column="1" Grid.ColumnSpan="3"
                               Grid.Row="2"
                               Text="{x:Static resources:Language.Settings_TextBox_DescriptionLogin}"
                               Style="{StaticResource textBlock_style_default}"
                               />
                    <TextBox Grid.Column="1"
                             Grid.Row="4"
                             Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Settings_TextBox_Username_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Account"
                             materialDesign:TextFieldAssist.HasClearButton ="True"
                             materialDesign:HintAssist.HelperText="{x:Static resources:Language.Universal_TextBlock_Lenght_HelperText}"
                             />

                    <PasswordBox Grid.Column="3"
                                 Grid.Row="4"
                                 x:Name="Password"
                                 PasswordChanged="Password_PasswordChanged"
                                 Style="{StaticResource passwordBox_style_default}"
                                 materialDesign:HintAssist.Hint="{x:Static resources:Language.Settings_TextBox_Password_Hint}"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Lock"
                                 materialDesign:TextFieldAssist.LeadingIconSize="16"
                                 materialDesign:TextFieldAssist.HasClearButton ="True"
                                 materialDesign:HintAssist.HelperText="{x:Static resources:Language.Universal_TextBlock_Lenght_HelperText}"
                                 />

                    <TextBox Grid.Column="1"
                             Grid.Row="6"
                             Text="{Binding UsernameConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:HintAssist.Hint="{x:Static resources:Language.Settings_TextBox_UsernameConfirmation_Hint}"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Account"
                             materialDesign:TextFieldAssist.HasClearButton ="True"
                             materialDesign:HintAssist.HelperText="{x:Static resources:Language.Universal_TextBlock_Lenght_HelperText}"
                             />

                    <PasswordBox Grid.Column="3"
                                 Grid.Row="6"
                                 x:Name="PasswordConfirmation"
                                 PasswordChanged="PasswordConfirmation_PasswordChanged"
                                 Style="{StaticResource passwordBox_style_default}"
                                 materialDesign:HintAssist.Hint="{x:Static resources:Language.Settings_TextBox_PasswordConfirmation_Hint}"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Lock"
                                 materialDesign:TextFieldAssist.LeadingIconSize="16"
                                 materialDesign:TextFieldAssist.HasClearButton ="True"
                                 materialDesign:HintAssist.HelperText="{x:Static resources:Language.Universal_TextBlock_Lenght_HelperText}"
                                 />

                    <Button Grid.Column="3"
                            Grid.Row="8"
                            Content="{x:Static resources:Language.Settings_Button_Save}"
                            Command="{Binding SaveUserDataCommand}"
                            Style="{StaticResource button_style_minor}"
                            help:ButtonIconHelper.IconKind="ContentSave"
                            />
                </Grid>
            </Border>
            
            <!--<Border Grid.Row="4"
                Style="{StaticResource border_style_dashboard_tile_light}">
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="0"/>
                    </Grid.RowDefinitions>                 

                    <TextBlock Grid.Column="1"
                               Grid.Row="1"
                               Text="Licence code:"
                               Style="{StaticResource textBlock_style_default}"
                               />
                    <Button Grid.Column="3"
                            Grid.Row="1"
                            Content="Save"
                            Command="{Binding SaveLicenceCommand}"
                            Style="{StaticResource button_style_minor}"
                            help:ButtonIconHelper.IconKind="ContentSave"
                            />
                    <TextBox Grid.Column="1" Grid.ColumnSpan="3"
                             Grid.Row="3"
                             Style="{StaticResource textBox_style_default}"
                             materialDesign:HintAssist.Hint="Licence"
                             />

                </Grid>
            </Border>-->
            
            
        </Grid>

    </Grid>
</UserControl>
