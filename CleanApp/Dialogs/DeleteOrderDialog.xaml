<UserControl x:Class="CleanApp.Dialogs.DeleteOrderDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CleanApp.Dialogs"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:help="clr-namespace:CleanApp.Helpers"
             xmlns:models="clr-namespace:CleanApp.Models"
             xmlns:resources="clr-namespace:CleanApp.Resources"  
             mc:Ignorable="d" 
             Height="150" 
             Width="310"
             d:Background="{StaticResource brush_background_dark}"
             >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="1" Grid.ColumnSpan="3"
                   Grid.Row="1"
                   Text="{x:Static resources:Language.Dialog_TextBlock_DeleteOrder}"
                   HorizontalAlignment="Center"
                   Style="{StaticResource textBlock_style_dashboardHeader}"
                   />

        <Button Grid.Column="1"
                Grid.Row="3"
                Content="{x:Static resources:Language.Dialog_Button_No}"
                Style="{StaticResource button_style_majorOutline}"
                help:ButtonIconHelper.IconKind="Close"
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                CommandParameter="False"/>

        <Button Grid.Column="3"
                Grid.Row="3"
                Content="{x:Static resources:Language.Dialog_Button_Yes}"
                Style="{StaticResource button_style_majorSolid}"
                help:ButtonIconHelper.IconKind="Check"
                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                CommandParameter="True"/>
    </Grid>
</UserControl>
