<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="listView_style_default"
           TargetType="ListView" 
           BasedOn="{StaticResource MaterialDesignListView}"
           >
        <Setter Property="FontSize" Value="{DynamicResource font_size_default}"/>
    </Style>
    
    <Style x:Key="listViewHearder_style_default"
           TargetType="GridViewColumnHeader"       
           >
        <Setter Property="Height" Value="35"/>
        <Setter Property="Background" Value="{DynamicResource brush_transparent}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10 0 0 0"/>
        <Setter Property="Foreground" Value="{DynamicResource brush_text_light}"/>
        <Setter Property="FontSize" Value="{DynamicResource font_size_default}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"                            
                            >
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                          />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>