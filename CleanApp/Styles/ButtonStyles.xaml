<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CleanApp.Helpers"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    
                    >

    <Style x:Key="button_style_majorSolid" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource brush_object_primary_dark}"/>
        <Setter Property="Foreground" Value="{DynamicResource brush_01}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="5"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="15" Height="15" Margin="0,0,5,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  >
                                <materialDesign:PackIcon Kind="{Binding Path=(local:ButtonIconHelper.IconKind),
                                                                    RelativeSource={RelativeSource TemplatedParent}}"
                                                         Width="16" Height="16"
                                                         Foreground="{TemplateBinding Foreground}"/>
                            </Grid>

                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource font_size_button}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource brush_object_primary_light}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="button_style_majorOutline" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource brush_00}"/>
        <Setter Property="Foreground" Value="{DynamicResource brush_02}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource brush_object_primary_light}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="5"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="15" Height="15" Margin="0,0,5,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="{Binding Path=(local:ButtonIconHelper.IconKind),
                                                                    RelativeSource={RelativeSource TemplatedParent}}"
                                                         Width="16" Height="16"
                                                         Foreground="{TemplateBinding Foreground}"/>
                            </Grid>

                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource font_size_button}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource brush_object_primary_dark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="button_style_minor" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource brush_object_secondary_dark}"/>
        <Setter Property="Foreground" Value="{DynamicResource brush_01}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="5"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="15" Height="15" Margin="0,0,5,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left">

                                <materialDesign:PackIcon Kind="{Binding Path=(local:ButtonIconHelper.IconKind),
                                                                    RelativeSource={RelativeSource TemplatedParent}}"
                                                         Width="16" Height="16"
                                                         Foreground="{TemplateBinding Foreground}"/>
                            </Grid>

                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource font_size_button}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource brush_object_primary_light}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="button_style_dashboardArrow" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource brush_transparent}"/>
        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource Self},
                                              Path=(local:ButtonForegroundHelper.ForegroundBrush)}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True"
                            Height="{TemplateBinding Height}"
                            Width="{TemplateBinding Width}"
                                                 
                            >
                        <materialDesign:PackIcon Kind="ChevronRight"
                                                 Foreground="{TemplateBinding Foreground}"
                                                 Height="30"
                                                 Width="30"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" 
                                    Value="{DynamicResource brush_object_secondary_light}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" 
                                    Value="{DynamicResource brush_object_secondary_light}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="button_style_iconOnlySmall"
           TargetType="Button"
           BasedOn="{StaticResource MaterialDesignIconButton}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <materialDesign:PackIcon Kind="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                    Path=(local:ButtonIconHelper.IconKind)}"
                                             Width="16"
                                             Height="16"
                                             Foreground="{DynamicResource MaterialDesignBody}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="button_style_iconOnlyBig"
           TargetType="Button"
           BasedOn="{StaticResource MaterialDesignIconButton}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <materialDesign:PackIcon Kind="{Binding RelativeSource={RelativeSource AncestorType=Button},
                                                    Path=(local:ButtonIconHelper.IconKind)}"
                                             Width="26"
                                             Height="26"
                                             Foreground="{DynamicResource MaterialDesignBody}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="button_style_iconShell" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource brush_ribbon_dark}"/>
        <Setter Property="Foreground" Value="{DynamicResource brush_00}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource brush_00}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            SnapsToDevicePixels="True">
                        <materialDesign:PackIcon x:Name="icon"
                                                 Kind="{Binding Path=(local:ButtonIconHelper.IconKind),
                                                                        RelativeSource={RelativeSource TemplatedParent}}"
                                                 Width="20" Height="20"
                                                 Foreground="{DynamicResource brush_leading}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource brush_ribbon_light}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="button_style_drag" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>