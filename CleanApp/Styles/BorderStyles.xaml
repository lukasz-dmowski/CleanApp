<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    >

    <Style x:Key="border_style_dashboard_tile_light" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource brush_dashboard_tile_light}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="10"
                                  Opacity="0.25"
                                  Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="border_style_dashboard_tile_dark" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource brush_dashboard_tile_dark}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="10"
                                  Opacity="0.25"
                                  Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>