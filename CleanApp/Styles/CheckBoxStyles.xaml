<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    >
    <Style x:Key="checkBox_style_default"
           TargetType="CheckBox" 
           BasedOn="{StaticResource MaterialDesignCheckBox}">
        <Setter Property="FontSize" Value="{DynamicResource font_size_default}"/>
    </Style>
    
    <Style x:Key="checkBox_style_filter_a"
           TargetType="CheckBox" 
           BasedOn="{StaticResource MaterialDesignFilterChipCheckBox}">
        <Setter Property="FontSize" Value="{DynamicResource font_size_default}"/>
    </Style>
    
    <Style x:Key="checkBox_style_filter_b"
           TargetType="CheckBox" 
           BasedOn="{StaticResource MaterialDesignFilterChipPrimaryCheckBox}">
        <Setter Property="FontSize" Value="{DynamicResource font_size_default}"/>
    </Style>
    
    <Style x:Key="checkBox_style_filter_c"
           TargetType="CheckBox" 
           BasedOn="{StaticResource MaterialDesignFilterChipPrimaryCheckBox}">
        <Setter Property="FontSize" Value="{DynamicResource font_size_default}"/>
    </Style>
    
</ResourceDictionary>