<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    >

    <Style x:Key="passwordBox_style_default"
           TargetType="PasswordBox"
           BasedOn="{StaticResource MaterialDesignPasswordBox}">
    </Style>
    
    <Style x:Key="passwordBox_style_login"
           TargetType="PasswordBox"
           BasedOn="{StaticResource MaterialDesignPasswordBox}">
        <Setter Property="Foreground"
                Value="{DynamicResource MaterialDesignBody}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsAuthenticationInvalid}" Value="True">
                <Setter Property="Foreground"
                        Value="{DynamicResource MaterialDesignValidationErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>