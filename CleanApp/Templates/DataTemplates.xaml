<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vms="clr-namespace:CleanApp.ViewModels"
                    xmlns:vs="clr-namespace:CleanApp.Views"
                    xmlns:conv="clr-namespace:CleanApp.Converters"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    >

    <DataTemplate DataType="{x:Type vms:LoginViewModel}">
        <vs:LoginView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vms:ShellViewModel}">
        <vs:ShellView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vms:InfoViewModel}">
        <vs:InfoView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:SettingsViewModel}">
        <vs:SettingsView/>
    </DataTemplate>    
    
    <DataTemplate DataType="{x:Type vms:DashboardViewModel}">
        <vs:DashboardView/>
    </DataTemplate>    
    <DataTemplate DataType="{x:Type vms:AddOrderViewModel}">
        <vs:AddOrderView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vms:ViewOrdersViewModel}">
        <vs:ViewOrdersView/>
    </DataTemplate>

    <conv:ItemTypeEnumToTextConverter x:Key="ItemTypeEnumToTextConverter"/>
    <conv:ItemStatusEnumToTextConverter x:Key="ItemStatusEnumToTextConverter"/>

    <conv:OrderNotificationToBoolConverter x:Key="OrderNotificationToBoolConverter"/>
    <conv:OrderCollectionToBoolConverter x:Key="OrderCollectionToBoolConverter"/>
    
    <conv:OrderReadinessToEnabledConverter x:Key="OrderReadinessToEnabledConverter"/>
    <conv:OrderNotificationToEnabledConverter x:Key="OrderNotificationToEnabledConverter"/>
    <conv:OrderCollectionToEnabledConverter x:Key="OrderCollectionToEnabledConverter"/>

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Styles/GeneralParameters.xaml"/>
        <ResourceDictionary Source="/Styles/BorderStyles.xaml"/>
        <ResourceDictionary Source="/Styles/BrushStyles.xaml"/>
        <ResourceDictionary Source="/Styles/ButtonStyles.xaml"/>
        <ResourceDictionary Source="/Styles/CheckBoxStyles.xaml"/>
        <ResourceDictionary Source="/Styles/ComboBoxStyles.xaml"/>
        <ResourceDictionary Source="/Styles/DatePickerStyles.xaml"/>
        <ResourceDictionary Source="/Styles/ListViewStyles.xaml"/>
        <ResourceDictionary Source="/Styles/ListBoxStyles.xaml"/>
        <ResourceDictionary Source="/Styles/PasswordBoxStyles.xaml"/>
        <ResourceDictionary Source="/Styles/RadioButtonStyles.xaml"/>
        <ResourceDictionary Source="/Styles/TextBlockStyles.xaml"/>
        <ResourceDictionary Source="/Styles/TextBoxStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    
</ResourceDictionary>